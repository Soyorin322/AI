# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Discord webhook for stock/ETF buy alerts (screen.py / bot.py)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/alert-channel-token

# Discord webhook for fund-flow cards (fund_tracker.py)
DISCORD_WEBHOOK_FUNDS=https://discord.com/api/webhooks/XXXXXXXX/funds-channel-token

# Discord application / bot (only needed if you use the interactive bot, bot.py)
DISCORD_APP_ID=your_discord_application_id
DISCORD_BOT_TOKEN=your_discord_bot_token
